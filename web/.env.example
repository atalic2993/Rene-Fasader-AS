# The GoHighLevel inbound webhook the lead form posts to.
# The browser never sees this. It posts to /api/skjema on this domain, and the
# server forwards from there, so content blockers cannot drop the lead.
# Without this set, /api/skjema answers 500 and the form shows the phone number.
LEAD_WEBHOOK_URL=

# Production URL, used for canonical links, Open Graph and the sitemap.
# No trailing slash.
NEXT_PUBLIC_SITE_URL=https://renefasader.kampanjeside.no
